{
  "name": "conjunto-app",
  "version": "1.0.0",
  "description": "Aplicacion de gestion para conjunto habitacional (backend + frontend + desktop Electron).",
  "author": "Nick Landeta",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "desktop:dev": "concurrently -k \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\" \"wait-on tcp:5173 && electron .\"",
    "desktop:icon": "node electron/scripts/generate-icon.js",
    "desktop:prepare-env": "node electron/scripts/prepare-backend-env.js",
    "desktop:build:renderer": "npm --prefix frontend run build",
    "desktop:build:backend-deps": "npm --prefix backend install --omit=dev",
    "desktop:pack": "npm run desktop:icon && npm run desktop:prepare-env && npm run desktop:build:renderer && npm run desktop:build:backend-deps && electron-builder --dir",
    "desktop:dist": "npm run desktop:icon && npm run desktop:prepare-env && npm run desktop:build:renderer && npm run desktop:build:backend-deps && electron-builder"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.2.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.4",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.casales.conjunto",
    "productName": "Conjunto App",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.cache/**/*"
        ]
      }
    ],
    "asarUnpack": [
      "backend/**"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "artifactName": "Conjunto-App-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
