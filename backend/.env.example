PORT=3000
# Para Supabase, usa la cadena de conexion de Postgres del proyecto y deja PGSSL=true.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=replace_with_a_strong_secret
CORS_ORIGIN=http://localhost:5173,https://tu-dominio.com
PUBLIC_APP_URL=
ALLOW_START_WITHOUT_DB=false
PGSSL=true

# Opcional: si prefieres variables separadas en vez de DATABASE_URL.
# PGHOST=db.YOUR-PROJECT-REF.supabase.co
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=postgres
